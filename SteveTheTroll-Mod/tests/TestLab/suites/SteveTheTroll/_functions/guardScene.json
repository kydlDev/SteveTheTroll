                  },
                  {
                      "do":  "give",
                      "prefab":  "STT_TrollSlippers",
                      "count":  1,
                      "equip":  true
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.addHub",
                      "args":  {
                                   "number":  1,
                                   "dx":  0,
                                   "dz":  25
                               }
                  },
                  { "do": "wait", "until": { "check": "hook", "name": "stt.worldReady", "expect": true }, "timeout": 30, "label": "D-231: the world around the player is loaded and its ground has settled (no fixed wait)", "stop": true },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTroll",
                      "args":  {
                                   "dx":  -14,
                                   "dz":  8
                               },
                      "as":  "troll"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.plantTree",
                      "args":  {
                                   "dx":  -10,
                                   "dz":  14
                               },
                      "label":  "a tree 6 m from the troll and 8 m from where the creature appears: the troll farms HERE and stays within the 20 m guard range (run 163541: with nothing near it ran 65 m to a log and the creature was out of reach)"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.startFarm",
                      "args":  {
                                   "troll":  "troll"
                               }
                  },
                  {
                      "do":  "wait",
                      "seconds":  2
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnMob",
                      "args":  {
                                   "prefab":  "{{prefab}}",
                                   "dx":  "{{mobDx}}",
                                   "dz":  "{{mobDz}}"
                               },
                      "as":  "mob"
                  }
              ]
}