{
    "name":  "ride-steer",
    "description":  "T-213: the rider\u0027s W (input in the rider\u0027s own frame) sends the troll along the camera direction; S alone stops it.",
    "timeout":  60,
    "steps":  [
                  {
                      "do":  "use",
                      "block":  "start",
                      "args":  {
                                   "clearTrolls":  true,
                                   "slippers":  true,
                                   "hub":  true
                               }
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTroll",
                      "args":  {
                                   "dx":  0,
                                   "dz":  16
                               },
                      "as":  "troll"
                  },
                  {
                      "do":  "wait",
                      "seconds":  1
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.rideVerdict",
                      "args":  {
                                   "troll":  "troll"
                               }
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.rideGiveHalter"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.rideAlt",
                      "args":  {
                                   "troll":  "troll"
                               }
                  },
                  {
                      "do":  "wait",
                      "seconds":  2
                  }
              ],
    "asserts":  [
                    {
                        "check":  "hook",
                        "name":  "stt.rideSteerW",
                        "args":  {
                                     "troll":  "troll",
                                     "lookEast":  1
                                 },
                        "contains":  "(1.00, 0.00, 0.00)",
                        "label":  "W with the camera looking east sends the troll east"
                    },
                    {
                        "check":  "hook",
                        "name":  "stt.rideSteerW",
                        "args":  {
                                     "troll":  "troll",
                                     "lookEast":  0
                                 },
                        "contains":  "(0.00, 0.00, -1.00)",
                        "label":  "W with the camera looking south sends the troll south"
                    },
                    {
                        "check":  "hook",
                        "name":  "stt.rideSteerS",
                        "args":  {
                                     "troll":  "troll"
                                 },
                        "contains":  "(0.00, 0.00, 0.00)",
                        "label":  "S alone stops the troll (no walking backwards)"
                    },
                    {
                        "check":  "hook",
                        "name":  "stt.rideRidden",
                        "args":  {
                                     "troll":  "troll"
                                 },
                        "expect":  true,
                        "label":  "still riding"
                    },
                    {
                        "check":  "noErrors",
                        "source":  "SteveTheTroll"
                    }
                ]
}
