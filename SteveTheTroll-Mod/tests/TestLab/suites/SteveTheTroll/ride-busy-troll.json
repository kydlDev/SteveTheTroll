{
    "name": "ride-busy-troll",
    "description": "T-213: a troll that the mod itself is driving (farming / recovery tick every frame) still walks where the rider steers it; clicks swing it.",
    "timeout": 90,
    "steps": [
        {
            "do": "use",
            "block": "start",
            "args": {
                "clearTrolls": true,
                "slippers": true,
                "hub": true,
                "hubDz":  -45
            }
        },
        {
            "do": "hook",
            "name": "stt.spawnTroll",
            "args": {
                "dx": 0,
                "dz": 16
            },
            "as": "troll"
        },
        {
            "do": "wait",
            "seconds": 1
        },
        {
            "do": "use",
            "block": "rideMount"
        },
        {
            "do": "hook",
            "name": "stt.mark",
            "args": {
                "troll": "troll"
            }
        },
        {
            "do": "hook",
            "name": "stt.rideDrive",
            "args": {
                "troll": "troll",
                "forward": 1
            }
        },
        {
            "do": "wait",
            "seconds": 4
        },
        {
            "do": "wait",
            "seconds": 1
        },
        {
            "do": "pressKey",
            "button": "Attack",
            "frames": 25
        },
        {
            "do": "wait",
            "seconds": 2
        },
        {
            "do": "pressKey",
            "button": "SecondaryAttack",
            "frames": 25
        },
        {
            "do": "wait",
            "seconds": 2
        },
        {
            "do": "hook",
            "name": "stt.rideDrive",
            "args": {
                "troll": "troll",
                "forward": 0
            }
        },
        {
            "do": "wait",
            "seconds": 4
        }
    ],
    "asserts": [
        {
            "check": "hook",
            "name": "stt.rideRidden",
            "args": {
                "troll": "troll"
            },
            "expect": true,
            "label": "still riding after W (not thrown off)"
        },
        {
            "check": "hook",
            "name": "stt.moved",
            "args": {
                "troll": "troll"
            },
            "min": 4,
            "label": "the troll walked while W was held (m)"
        },
        {
            "check": "hook",
            "name": "stt.rideSpeedXZ",
            "args": {
                "troll": "troll"
            },
            "max": 20,
            "label": "T-217 R6: 4 s after W was released the troll has stopped (flat speed, cm/s)"
        },
        {
            "check": "hook",
            "name": "stt.rideForeignMoveSets",
            "args": {
                "troll": "troll"
            },
            "max": 0,
            "label": "T-217 R6: nothing but the saddle set the move direction during the ride"
        },
        {
            "check": "noErrors",
            "source": "SteveTheTroll"
        }
    ]
}
